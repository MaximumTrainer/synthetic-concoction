# Copy to .env for docker compose. Placeholders only — never commit real values.

# --- First-run authentication -------------------------------------------------
# Seeds a bootstrap account and API key on startup. Generate a long random value:
#   openssl rand -base64 32
FABRICATE__BootstrapApiKey=replace-with-a-long-random-value

# --- Database (compose wires the connection string; only the password is needed here) ---
POSTGRES_PASSWORD=fabricate

# --- Operator (platform) LLM credential --------------------------------------
# Leave FABRICATE_LLM_PROVIDER empty to run with per-workspace credentials only.
# Providers: anthropic | openai-compatible | bedrock | vertex | foundry
FABRICATE_LLM_PROVIDER=anthropic
FABRICATE_LLM_MODEL=claude-opus-5
FABRICATE_LLM_ALLOWED_MODELS=claude-opus-5,claude-sonnet-5

# NAME of the variable holding the key (below), not the key itself.
FABRICATE_LLM_API_KEY_SECRET=ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=sk-ant-replace-me

# openai-compatible only: FABRICATE_LLM_BASE_URL=https://api.openai.com/v1
# bedrock only:           FABRICATE_LLM_REGION=eu-west-1        (ambient IAM credentials)
# vertex only:            FABRICATE_LLM_PROJECT_ID=my-project FABRICATE_LLM_LOCATION=global   (ADC)
# foundry only:           FABRICATE_LLM_BASE_URL=https://<resource>.services.ai.azure.com

# When workspaces without their own credential may use the platform one:
#   always | workspace-opt-in | never      (single-operator self-hosting: always)
FABRICATE_LLM_PLATFORM_FALLBACK=always

# Optional tuning
# FABRICATE_LLM_EFFORT=high                 low | medium | high | max (where the provider supports it)
# FABRICATE_LLM_MAX_OUTPUT_TOKENS=16000
# FABRICATE_LLM_TIMEOUT_SECONDS=120
# FABRICATE_LLM_MAX_TOOL_ITERATIONS=8
# FABRICATE_LLM_HISTORY_WINDOW=40

# Egress controls for tenant-supplied endpoints (BYOK)
# FABRICATE_LLM_ALLOWED_ENDPOINT_HOSTS=openai.com,anthropic.com
# FABRICATE_LLM_ALLOW_PRIVATE_ENDPOINTS=false   set true for an air-gapped local runtime (e.g. http://ollama:11434/v1)
