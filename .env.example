# Copy to .env for docker compose. Placeholders only — never commit real values.

# --- First-run authentication -------------------------------------------------
# Seeds a bootstrap account and API key on startup. Generate a long random value:
#   openssl rand -base64 32
FABRICATE__BootstrapApiKey=replace-with-a-long-random-value

# --- Database (compose wires the connection string; only the password is needed here) ---
POSTGRES_PASSWORD=fabricate

# --- Operator (platform) LLM credential --------------------------------------
# Leave FABRICATE_LLM_PROVIDER empty to run with per-workspace credentials only.
# Providers: anthropic | openai-compatible | bedrock | vertex | foundry
FABRICATE_LLM_PROVIDER=anthropic
FABRICATE_LLM_MODEL=claude-opus-5
FABRICATE_LLM_ALLOWED_MODELS=claude-opus-5,claude-sonnet-5

# NAME of the variable holding the key (below), not the key itself.
FABRICATE_LLM_API_KEY_SECRET=ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=sk-ant-replace-me

# openai-compatible only: FABRICATE_LLM_BASE_URL=https://api.openai.com/v1
# bedrock only:           FABRICATE_LLM_REGION=eu-west-1        (ambient IAM credentials)
# vertex only:            FABRICATE_LLM_PROJECT_ID=my-project FABRICATE_LLM_LOCATION=global   (ADC)
# foundry only:           FABRICATE_LLM_BASE_URL=https://<resource>.services.ai.azure.com

# When workspaces without their own credential may use the platform one:
#   always | workspace-opt-in | never      (single-operator self-hosting: always)
FABRICATE_LLM_PLATFORM_FALLBACK=always

# Optional tuning
# FABRICATE_LLM_EFFORT=high                 low | medium | high | max (where the provider supports it)
# FABRICATE_LLM_MAX_OUTPUT_TOKENS=16000
# FABRICATE_LLM_TIMEOUT_SECONDS=120
# FABRICATE_LLM_MAX_TOOL_ITERATIONS=8
# FABRICATE_LLM_HISTORY_WINDOW=40
# FABRICATE_LLM_MAX_INPUT_TOKENS=120000     estimated input budget per request; oldest history is dropped to fit (0 = off)
# FABRICATE_LLM_MAX_RETRIES=2               retries of rate-limit/transport/timeout/5xx failures with exponential backoff

# Egress controls for tenant-supplied endpoints (BYOK)
# FABRICATE_LLM_ALLOWED_ENDPOINT_HOSTS=openai.com,anthropic.com
# FABRICATE_LLM_ALLOW_PRIVATE_ENDPOINTS=false   set true for an air-gapped local runtime (e.g. http://ollama:11434/v1)

# Audit retention (#74). Default 0 keeps every event forever; a positive value starts a background
# sweep that deletes events strictly older than the window, across every account, in batches.
# Export before shortening a window — deleting audit history may itself be regulated.
# FABRICATE_AUDIT_RETENTION_DAYS=90
# FABRICATE_AUDIT_SWEEP_MINUTES=360           how often the sweep runs (default 360, six hours)
# FABRICATE_AUDIT_PURGE_BATCH_SIZE=1000       rows per DELETE, so a long backlog does not hold one long lock

# Per-request usage auditing (#72). Records one api.request audit event per authenticated request:
# which key called which route template, with method, status, scopes and duration. Never headers or bodies.
# Default 1.0 records every request; 0 switches it off. Retention above applies to these too.
# FABRICATE_API_USAGE_SAMPLING=1.0

# Data Protection key ring (#76). This is what decrypts stored tenant credentials, so losing it loses them
# permanently — the ciphertext stays in the database and nothing can read it again. The default filesystem
# store is correct only where the directory is on shared, persistent storage. On Fly, Cloud Run, Container
# Apps, ECS, or with more than one instance, use the database store; it needs the acknowledgement because the
# ring then sits in the same database as the secrets it protects.
# FABRICATE_DATA_PROTECTION_KEY_STORE=database
# FABRICATE_DATA_PROTECTION_ALLOW_UNWRAPPED=true
# FABRICATE_DATA_PROTECTION_KEYS_PATH=/data/keys              filesystem store only

# Artifact storage (#84). The local filesystem is ephemeral on every hosted target, so a completed run
# ends up pointing at files that no longer exist. One adapter covers AWS S3, MinIO, R2 and Backblaze B2.
# Ambient cloud identity is used when the two *_SECRET variables are unset — no key stored anywhere.
# FABRICATE_ARTIFACT_STORE=s3
# FABRICATE_ARTIFACT_BUCKET=fabricate-artifacts
# FABRICATE_ARTIFACT_S3_REGION=eu-west-1            for AWS
# FABRICATE_ARTIFACT_S3_ENDPOINT=https://...        for MinIO / R2 / Backblaze
# FABRICATE_ARTIFACT_S3_FORCE_PATH_STYLE=true       required by most non-AWS stores
# FABRICATE_ARTIFACT_S3_ACCESS_KEY_SECRET=ARTIFACT_ACCESS_KEY   secret *name*, not the key
# FABRICATE_ARTIFACT_S3_SECRET_KEY_SECRET=ARTIFACT_SECRET_KEY
# Azure Blob and GCS (#90) - the native store on each cloud, with ambient identity and no stored key.
# FABRICATE_ARTIFACT_STORE=azure-blob
# FABRICATE_ARTIFACT_AZURE_ACCOUNT_URL=https://acme.blob.core.windows.net   managed identity
# FABRICATE_ARTIFACT_AZURE_CONNECTION_STRING_SECRET=ARTIFACT_AZURE_CS       secret *name*, outside Azure only
# FABRICATE_ARTIFACT_STORE=gcs
# FABRICATE_ARTIFACT_GCS_PROJECT_ID=my-project
# FABRICATE_ARTIFACT_GCS_CREDENTIALS_SECRET=ARTIFACT_GCS_KEY                secret *name*, outside GCP only
# FABRICATE_ARTIFACT_RETENTION_DAYS=90              0 (default) keeps artifacts indefinitely
